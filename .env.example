# API Backend
VITE_URL_BACKEND=http://localhost:3000

# Spotify Widget Configuration
# Get these credentials from: https://developer.spotify.com/dashboard
# 1. Create a new app
# 2. Copy Client ID and Client Secret
# 3. Add redirect URI: http://localhost:5173/spotify-callback (or your domain)
VITE_SPOTIPY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
VITE_SPOTIPY_SCOPE=user-read-playback-state,user-modify-playback-state,user-read-currently-playing,user-read-recently-played
